# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox).
# Use a US sandbox business account as the merchant (the supplier in the demo).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Defaults to https://api-m.sandbox.paypal.com
# PAYPAL_BASE_URL=

# Claude API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# Where deal JSON files are stored (defaults to ./.data/deals).
# SPECLOCK_DATA_DIR=
