# Copy to .env.local. Never commit real values. Sandbox only.

# PostgreSQL (authoritative store)
DATABASE_URL=postgres://localhost:5432/pact_dev
# Used in PayPal return URLs and review links
APP_ORIGIN=http://localhost:3000

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# Pact refuses any non-sandbox base URL.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the sandbox app's webhook settings; unverified webhooks are rejected.
PAYPAL_WEBHOOK_ID=
# Optional: sandbox merchant (payee) ID; when set, orders paying anyone else are refused.
PAYPAL_MERCHANT_ID=

# Model provider for proposal extraction (Gemini). Without a key the deterministic baseline is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Set to "baseline" to disable the model.
# PACT_AI_MODE=baseline

# Password for seeded synthetic demo users (defaults to pact-demo-only).
# SEED_PASSWORD=

# Tried once if the primary model is overloaded (503/429/timeout). Empty disables.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Optional Telegram private-chat intake. Set the real token only in .env.local or a secret manager.
# TELEGRAM_BOT_TOKEN=
