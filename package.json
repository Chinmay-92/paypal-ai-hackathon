{
  "name": "pact",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "eval:ai": "node --env-file-if-exists=.env.local --import tsx scripts/eval-ai.ts",
    "smoke:paypal": "node --env-file-if-exists=.env.local --import tsx scripts/paypal-smoke.ts",
    "check:docs": "python3 scripts/check_pact_docs.py"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
